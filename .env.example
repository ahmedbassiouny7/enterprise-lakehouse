# Local-only development configuration. Copy to .env before starting Compose.
SPARK_MASTER_HOST=master
NAMENODE_UI_PORT=9870
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_RPC_PORT=7077
SPARK_WORKER_UI_PORT=8081
SPARK_HISTORY_UI_PORT=18080
HIVE_METASTORE_THRIFT_PORT=9083
HIVESERVER2_PORT=10000

# Must match values embedded in the inherited Hadoop/Hive image.
METASTORE_DB=metastore
METASTORE_USER=jupyter
METASTORE_PASSWORD=jupyter
METASTORE_PORT=5434

POSTGRES_ORDERS_DB=orders_db
POSTGRES_ORDERS_USER=orders_app
POSTGRES_ORDERS_PASSWORD=orders_app_pw
POSTGRES_ORDERS_PORT=5432

MYSQL_CUSTOMERS_DB=customers_db
MYSQL_CUSTOMERS_USER=customers_app
MYSQL_CUSTOMERS_PASSWORD=customers_app_pw
MYSQL_ROOT_PASSWORD=customers_root_pw
MYSQL_CUSTOMERS_PORT=3306

TRINO_PORT=8082

AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_pw
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_WEBSERVER_PORT=8083
# Development-only, valid Fernet key. Generate a unique key for any shared environment.
AIRFLOW__CORE__FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-before-sharing
